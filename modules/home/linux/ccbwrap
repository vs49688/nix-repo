#!/usr/bin/env bash

# Refuse to run from a directory that would re-expose the real home. The
# `--bind "$PWD"` below runs after `--tmpfs /home`, so binding $HOME (or any
# ancestor of it) would silently undo the sandbox.
if [ "$PWD" = / ] || [ "$HOME" = "$PWD" ] || [[ "$HOME" == "$PWD"/* ]]; then
    echo "ccbwrap: refusing to run from $PWD (would re-expose \$HOME)" >&2
    exit 1
fi

function applyFiles () {
    local flag=$1; shift
    for i in "$@"; do
        [[ ( -d "$i" ) || ( -f "$i" ) || ( -S "$i" ) || ( -c "$i" ) ]] && command+=("${flag}" "$i" "$i")
    done
}

##
# The display and audio sockets are named by the session, not by us. Binding a
# hardcoded wayland-0 puts no socket in the sandbox at all when the compositor took
# the next name, and applyFiles skips a missing path without saying so -- which is
# the right thing for an optional path and the wrong thing for this one.
##
runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
wayland_display="${WAYLAND_DISPLAY:-wayland-0}"
pipewire_socket="${PIPEWIRE_REMOTE:-pipewire-0}"

# WAYLAND_DISPLAY names a socket in the runtime directory, or an absolute path.
case "$wayland_display" in
    /*) wayland_socket="$wayland_display" ;;
    *)  wayland_socket="$runtime_dir/$wayland_display" ;;
esac

[[ -S "$wayland_socket" ]] ||
    echo "ccbwrap: no Wayland socket at $wayland_socket" >&2

command=(
    bwrap
    --setenv    OPENCODE_DISABLE_LSP_DOWNLOAD   true
    --setenv    OPENCODE_EXPERIMENTAL_LSP_TOOL  true
    --setenv    XDG_RUNTIME_DIR                 "$runtime_dir"
    --setenv    WAYLAND_DISPLAY                 "$wayland_display"
    # No X11: an X client can read the whole screen and every keypress in the
    # session, which is the one thing this sandbox exists to prevent.
    --unsetenv  DISPLAY
    # Nor the session bus: org.freedesktop.systemd1's StartTransientUnit runs
    # anything as the user, outside this namespace, with no prompt.
    --unsetenv  DBUS_SESSION_BUS_ADDRESS
    --proc      /proc
    --die-with-parent
    --unshare-pid

    --ro-bind   /bin/sh      /bin/sh
    --ro-bind   /usr/bin/env /usr/bin/env
    --dev /dev
)

[[ -f "$HOME/.config/git/config.agent" ]] && command+=(
    --setenv GIT_CONFIG_GLOBAL "$HOME/.config/git/config.agent"
)

applyFiles --dev-bind /dev/dri /dev/kvm

applyFiles --ro-bind        \
    /nix                    \
    /run/current-system     \
    /run/opengl-driver      \
    /run/opengl-driver-32   \
    /etc                    \
    /sys/dev/char           \
    /sys/devices/pci0000:00 \
    /sys/devices/virtual

command+=(
    --tmpfs     /tmp
    --tmpfs     /home
)

applyFiles --ro-bind \
    "$HOME/.config/sops-nix/secrets/deepseek_api_key" \
    "$HOME/.config/sops-nix/secrets/agents"

applyFiles --ro-bind    \
    "$HOME/.config/git" \
    "$HOME/.config/Croc"

applyFiles --bind                   \
    "$HOME/.minetest"               \
    "$HOME/.pi"                     \
    "$HOME/.local/share/cartopy"    \
    "$HOME/.cache/go-build"         \
    "$HOME/.cache/nix"              \
    "/games"                        \
    "$HOME/Games"                   \
    "$HOME/Documents/Coding"        \
    /run/postgresql                 \
    /run/nscd                       \
    "$wayland_socket"              \
    "$runtime_dir/$pipewire_socket" \
    "$runtime_dir/pulse/native"

command+=(
    --symlink /run /var/run
)

applyFiles --bind "$PWD"

command+=(
    --chdir     "$PWD"
    --
)

command+=("$@")

exec "${command[@]}"
